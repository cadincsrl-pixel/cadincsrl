PORT=3001
NODE_ENV=development

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

FRONTEND_URL=http://localhost:3000


# ── GPS Mobile Quest ─────────────────────────────────────────────────
# Cliente para sincronización de km y posición desde el GPS satelital.
# Si MOBILE_QUEST_BASE_URL queda vacío, usa el default productivo.
MOBILE_QUEST_BASE_URL=https://mobilequest.com.ar/gis-api
MOBILE_QUEST_USERNAME=
MOBILE_QUEST_PASSWORD=

# Secret compartido para autenticar el endpoint del cron de sync GPS.
# Generar con: openssl rand -hex 32
# Vercel Cron envía automáticamente este valor como `Authorization: Bearer ${CRON_SECRET}`
# si está configurado como variable de entorno del proyecto.
CRON_SECRET=

# ── Google Maps Platform ─────────────────────────────────────────────
# Distance Matrix API + Geocoding API. Habilitar billing en GCP y crear
# API key restringida a esos 2 servicios + dominio del backend.
# Free tier: $200 USD/mes (~40k elementos de Distance Matrix).
GOOGLE_MAPS_API_KEY=

# ── Asistente IA (Claude API) ────────────────────────────────────────
# Key de https://console.anthropic.com/settings/keys. Si queda vacía,
# el endpoint /api/asistente/chat responde 503 ASISTENTE_NO_CONFIGURADO
# (el resto del sistema funciona igual — degrada limpio).
ANTHROPIC_API_KEY=
# Modelo a usar (opcional). Default: claude-sonnet-5.
# ASISTENTE_MODEL=claude-sonnet-5
# Compras: lectura completa de la factura ("archivo primero") y control del papel.
# Default claude-opus-5 para los dos; el control usa PAGOS_CONTROL_MODEL si está.
# PAGOS_LECTURA_MODEL=claude-opus-5
# PAGOS_CONTROL_MODEL=claude-opus-5
# ── Correo saliente (SMTP) ───────────────────────────────────────────
# Lo usa el AVISO DE PAGO del módulo Pagos: al emitir una orden de pago se
# puede avisar con un clic al proveedor (comprobante) y al contador
# (comprobante + facturas). Es el único correo que manda el sistema.
#
# Son las casillas propias de la empresa en Hostinger, no un servicio de
# terceros: así el remitente es una dirección real de CADINC, que es lo que un
# proveedor espera ver, y no hay que tocar DNS.
#
# Datos de Hostinger: host smtp.hostinger.com, puerto 465 (SSL). SMTP_USER es
# la dirección COMPLETA de la casilla y SMTP_PASS su contraseña — la de la
# casilla, no la del panel de Hostinger.
#
# SIN ESTO EL SISTEMA ANDA IGUAL: el botón de avisar avisa que falta
# configurarlo (GET /api/pagos/mail/estado lo dice) y nada más se rompe.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Lo que ve el destinatario en «De:». Si queda vacío se usa SMTP_USER.
SMTP_FROM=CADINC SRL <pagos@cadinc.com.ar>
# A dónde caen las respuestas del proveedor. Opcional; vacío = al SMTP_FROM.
SMTP_REPLY_TO=
# Casilla del estudio contable. Si queda vacía, se busca el usuario activo con
# rol `contador` y se usa su mail de la cuenta.
CONTADOR_EMAIL=
# Nombre que se imprime en el mail. Default 'CADINC SRL'.
EMPRESA_NOMBRE=CADINC SRL
